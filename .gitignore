# Unity3D generated meta files that should stay OUT only if not tracked already (keep .meta files!)
# (we do NOT ignore *.meta, those must be committed)

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

